VAL_ 521 GEAR_ACTUAL 6 "6th" 5 "5th" 4 "4th" 3 "3rd" 2 "2nd" 1 "1st" 0 "neutral" ;
VAL_ 521 TCS_LEVEL 3 "TCS M (manual)" 2 "TCS 2" 1 "TCS 1" 0 "probably TCS OFF (not confirmed)" ;
VAL_ 521 GEAR_REQUESTED 7 "between gears" 6 "6th" 5 "5th" 4 "4th" 3 "3rd" 2 "2nd" 1 "1st" 0 "neutral" ;
VAL_ 521 RIDE_MODE 3 "D-MODE 4" 2 "D-MODE 3" 1 "D-MODE 2" 0 "D-MODE 1" ;
